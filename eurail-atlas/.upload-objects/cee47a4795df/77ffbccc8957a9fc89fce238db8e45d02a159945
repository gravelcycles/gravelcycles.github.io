{"aggregateIdentityMetadata":{"schemaVersion":1,"inputManifestSha256":"dcb2388941b438a496db7dee18454ebde133a36c1e768ba6a9cbb40b1271cac5","policySha256":"3b4c4195c33ed681a8f34957f23e47912927239ff8991c89b27c2bcc3282cb4d","producerSha256":"b34ba11507760e97354f23971bf94023486093a59696fc43462fddf0b3a7649d","checkedAssets":3899,"changedAssets":[],"immutableStationProofHistoryAssets":0,"onlyAnonymousIdentityPlaceholdersRemoved":true,"allCountsCallsGeometrySourceModesAndClocksPreserved":true,"outputAssetInventorySha256":"30b274c44906023ecef38ce6917f4f1ab0569a919bde0e37491c2c085371d941"},"borderPolicyReference":{"dates":{"serviceDates":["2026-11-29","2026-11-30","2026-12-01","2026-12-02","2026-12-03","2026-12-04","2026-12-05"],"validFrom":"2026-11-01","validThrough":"2026-12-12"},"file":"official-border-policy-reference.json","scope":"Global Pass, ordinary second class. These narrow host-country rules supplement the issuer company table; they do not change canonical calls, geometry, train operation or seat availability.","sha256":"4902d148719cf9fd678d1cf04c6b300f789ba1fdfa06e30c1a2441b79cad612d","sources":[{"checked_at":"2026-11-02","evidence_summary":"The issuer explicitly includes Ventimiglia, Italy among bordering-country stations covered by a pass valid in France. Its regional TER section describes pass travel without routine reservations. This evidence is restricted here to the published SNCF C3 coastal service whose only Italian call is Ventimiglia.","id":"issuer-france-border-stations-2026","publisher":"Interrail/Eurail","url":"https://www.interrail.com/en/plan-your-trip/tips-and-tricks/trains-europe/trains-country/trains-france"},{"evidence_summary":"The issuer describes Lyon-Geneva TER and Annecy-Geneva Léman Express as pass-covered alternatives without reservations.","id":"issuer-lyon-geneva-ter-lex","publisher":"Interrail/Eurail","publisher_updated_at":"2026-09-08","url":"https://help.interrail.com/hc/en-001/articles/9109345417245-How-to-go-from-Paris-to-Lyon-and-